{
  "name": "t040-student-discipline-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node backend/src/server.js",
    "seed": "node backend/src/db/seed.js",
    "migrate:incident-subject": "node backend/src/db/migrateIncidentSubject.js",
    "test": "node --test backend/test/*.test.js",
    "test:integration": "node --test backend/test/incident.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.16.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
